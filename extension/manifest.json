{
  "manifest_version": 3,
  "name": "Comparateur de Paniers — Connecteur Drive",
  "description": "Collecte locale et volontaire des prix affichés par les catalogues Drive sélectionnés.",
  "version": "0.5.98",
  "minimum_chrome_version": "109",
  "permissions": ["tabs", "storage", "scripting"],
  "host_permissions": [
    "https://*.leclercdrive.fr/*",
    "https://*.coursesu.com/*"
  ],
  "background": {
    "scripts": ["background/service-worker.js"],
    "type": "module"
  },
  "action": {
    "default_title": "Comparateur de Paniers — Drive"
  },
  "content_scripts": [
    {
      "matches": [
        "https://fredo0xjtl.github.io/Comparateur-de-Paniers/*"
      ],
      "js": ["bridge/pwa-bridge.js"],
      "run_at": "document_start"
    }
  ],
  "options_page": "options/options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
