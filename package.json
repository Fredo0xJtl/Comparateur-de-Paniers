{
  "name": "comparateur-de-paniers",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "node tools/build-pages.mjs",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -b",
    "privacy:check": "node tools/privacy-check.mjs",
    "extension:check": "node tools/validate-extension.mjs",
    "extension:build:chromium": "node tools/build-chromium-extension.mjs",
    "extension:build:firefox": "node tools/build-firefox-extension.mjs",
    "extension:build:firefox:dev": "node tools/build-firefox-extension.mjs --dev",
    "extension:build:firefox:dev:5174": "node tools/build-firefox-extension.mjs --dev-port=5174",
    "extension:build:firefox:dev:4174": "node tools/build-firefox-extension.mjs --dev-port=4174",
    "extension:package": "node tools/build-firefox-extension.mjs && node tools/package-firefox-extension.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "@zxing/library": "^0.23.0",
    "dexie": "^4.4.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.4.6",
    "vite-plugin-mkcert": "^2.1.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  }
}
