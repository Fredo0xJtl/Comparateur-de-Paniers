{
  "name": "comparateur-de-paniers",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "node tools/build-pages.mjs",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -b",
    "privacy:check": "node tools/privacy-check.mjs",
    "extension:check": "node tools/validate-extension.mjs",
    "extension:build:firefox": "node tools/build-firefox-extension.mjs",
    "extension:build:firefox:dev": "node tools/build-firefox-extension.mjs --dev",
    "extension:build:firefox:dev:5174": "node tools/build-firefox-extension.mjs --dev-port=5174",
    "extension:build:firefox:dev:4174": "node tools/build-firefox-extension.mjs --dev-port=4174",
    "extension:package": "node tools/build-firefox-extension.mjs && node tools/package-firefox-extension.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "@zxing/library": "^0.23.0",
    "dexie": "^4.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.4.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "vite-plugin-mkcert": "^2.1.0",
    "vitest": "^4.1.10"
  }
}
